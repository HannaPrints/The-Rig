# Copy to .env and fill in. NEVER commit .env — it is gitignored.
# The deployer key signs launchToken (nonce 0) and the Deploy script (nonces 1-11).
# Treat it as disposable: fund gas only, transfer owner surfaces to a multisig after wiring.

# --- shared ---
RPC_URL=https://rpc.mainnet.chain.robinhood.com
CHAIN_ID=4663
PRIVATE_KEY=

# --- Pons / Robinhood Chain constants (verified live on mainnet) ---
PONS_V2_FACTORY=0x7eD598BcEf8bd9Edd8C97A195C6d13f40801EC7e
FEE_ESCROW=0xd3AFEB2a57f70eF218Aa82451c51B2fb0416Ac9e
WETH_ADDRESS=0x0Bd7D308f8E1639FAb988df18A8011f41EAcAD73
POOL_FEE=10000

# --- predicted for deployer 0x9d70e087EF8f50d2d30cE0577291D44F5083B015 (see docs/DEPLOY.md) ---
# Re-run script/predict-pons-ca.sh after freezing final token metadata!
GPU_TOKEN=0xf25EC3284De67E1A584E91Ae2B6a9436671cF053
CURVE=0xf16cE575C523Bf0cE60B061d264664d1d3aFf5F1
EXPECTED_FEE_ROUTER=0x1C92372E0f2D0eD1CF716632734f041C57f60a8F

# --- fill before deploy ---
ETH_USD_FEED=      # Chainlink ETH/USD on Robinhood Chain
KEEPER=            # keeper bot address (dedicated hot key)
SIGNER=            # permit signer address (dedicated hot key)
TREASURY=          # ops multisig — receives the 30% + 20% of creator fees

# --- services ---
SIGNER_PK=
KEEPER_PK=
SHOP_ADDRESS=
VAULT_ADDRESS=
CURVE_ADDRESS=0xf16cE575C523Bf0cE60B061d264664d1d3aFf5F1
QUOTE_MODE=curve   # switch to univ3 + rotate adapter after graduation
QUOTER_ADDRESS=    # only needed post-graduation
